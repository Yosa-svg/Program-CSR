generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN_CSR
}

enum ActivityAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  password     String
  role         Role           @default(ADMIN_CSR)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  activityLogs ActivityLog[]
}

model AdminSession {
  id            String    @id @default(uuid())
  userId        String
  sessionToken  String    @unique @db.VarChar(255)
  ipAddress     String?   @db.VarChar(45)
  userAgent     String?   @db.VarChar(500)
  deviceType    String?   @db.VarChar(50)
  isActive      Boolean   @default(true)
  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?   @db.VarChar(255)
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  endedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "AdminSession_userId_idx")
  @@index([lastActiveAt], map: "AdminSession_lastActiveAt_idx")
  @@index([isActive, isRevoked], map: "AdminSession_active_status_idx")
}

model ActivityLog {
  id          String         @id @default(uuid())
  userId      String?
  action      ActivityAction
  entityType  String         @db.VarChar(50)
  entityId    String?        @db.VarChar(100)
  entityTitle String?        @db.VarChar(255)
  description String         @db.VarChar(500)
  metadata    Json?
  ipAddress   String?        @db.VarChar(45)
  userAgent   String?        @db.VarChar(500)
  createdAt   DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "ActivityLog_userId_idx")
  @@index([action], map: "ActivityLog_action_idx")
  @@index([entityType], map: "ActivityLog_entityType_idx")
  @@index([createdAt], map: "ActivityLog_createdAt_idx")
}

model Sector {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String          @unique
  activities     Activity[]
  documentations Documentation[]
  metrics        Metric[]
  products       Product[]
  programs       Program[]
}

model Program {
  id                 String          @id @default(uuid())
  title              String
  slug               String          @unique
  description        String          @db.Text
  location           String
  beneficiaries      String
  status             String          @default("ACTIVE")
  imageUrl           String          @db.VarChar(1000)
  isPublished        Boolean         @default(false)
  source             String?
  sourceType         String?
  sourceUrl          String?         @db.VarChar(1000)
  verificationStatus String?         @default("BELUM_TERVERIFIKASI")
  sectorId           String
  activities         Activity[]
  documentations     Documentation[]
  metrics            Metric[]
  products           Product[]
  sector             Sector          @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@index([sectorId], map: "Program_sectorId_fkey")
}

model Activity {
  id                 String          @id @default(uuid())
  title              String
  description        String          @db.Text
  location           String?
  date               DateTime?
  status             String          @default("UPCOMING")
  isPublished        Boolean         @default(false)
  source             String?
  sourceType         String?
  sourceUrl          String?         @db.VarChar(1000)
  verificationStatus String?         @default("BELUM_TERVERIFIKASI")
  programId          String?
  sectorId           String
  program            Program?        @relation(fields: [programId], references: [id])
  sector             Sector          @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  documentations     Documentation[]

  @@index([programId], map: "Activity_programId_fkey")
  @@index([sectorId], map: "Activity_sectorId_fkey")
}

model Product {
  id                 String          @id @default(uuid())
  name               String
  description        String          @db.Text
  category           String          @default("Umum")
  status             String          @default("AVAILABLE")
  imageUrl           String          @default("/images/placeholder.jpg") @db.VarChar(1000)
  isPublished        Boolean         @default(false)
  slug               String          @unique
  capacity           String?
  unit               String?
  marketing          String?
  certification      String?
  source             String?
  sourceType         String?
  sourceUrl          String?         @db.VarChar(1000)
  verificationStatus String?         @default("BELUM_TERVERIFIKASI")
  programId          String?
  sectorId           String
  documentations     Documentation[]
  program            Program?        @relation(fields: [programId], references: [id])
  sector             Sector          @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@index([programId], map: "Product_programId_fkey")
  @@index([sectorId], map: "Product_sectorId_fkey")
}

model Documentation {
  id                 String    @id @default(uuid())
  title              String
  description        String?   @db.Text
  imageUrl           String    @db.VarChar(1000)
  date               DateTime?
  status             String    @default("PUBLISHED")
  isPublished        Boolean   @default(false)
  isFeatured         Boolean   @default(false)
  source             String?
  sourceType         String?
  sourceUrl          String?   @db.VarChar(1000)
  verificationStatus String?   @default("BELUM_TERVERIFIKASI")
  programId          String?
  activityId         String?
  productId          String?
  sectorId           String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  activity           Activity? @relation(fields: [activityId], references: [id])
  product            Product?  @relation(fields: [productId], references: [id])
  program            Program?  @relation(fields: [programId], references: [id])
  sector             Sector    @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@index([activityId], map: "Documentation_activityId_fkey")
  @@index([productId], map: "Documentation_productId_fkey")
  @@index([programId], map: "Documentation_programId_fkey")
  @@index([sectorId], map: "Documentation_sectorId_fkey")
  @@index([isFeatured, isPublished], map: "Documentation_isFeatured_isPublished_idx")
}

model Metric {
  id                 String   @id @default(uuid())
  name               String
  description        String?  @db.Text
  category           String   @default("OUTCOME")
  unit               String?
  target             Float?
  realization        Float?
  value              String?
  year               Int?
  period             String?
  status             String   @default("PUBLISHED")
  isPublished        Boolean  @default(false)
  source             String?
  sourceType         String?
  sourceUrl          String?  @db.VarChar(1000)
  verificationStatus String?  @default("BELUM_TERVERIFIKASI")
  programId          String?
  sectorId           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  program            Program? @relation(fields: [programId], references: [id])
  sector             Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@index([programId], map: "Metric_programId_fkey")
  @@index([sectorId], map: "Metric_sectorId_fkey")
}
