generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password       String
  role           String    // SUPER_ADMIN, ADMIN_PUSAT, ADMIN_SEKTOR
  
  sectorId       String?   // Hanya untuk ADMIN_SEKTOR
  sector         Sector?   @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Sector {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String          @unique
  users          User[]
  programs       Program[]
  activities     Activity[]
  products       Product[]
  documentations Documentation[]
  metrics        Metric[]
}

model Program {
  id               String   @id @default(uuid())
  title            String
  description      String
  location         String
  beneficiaries    String
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, PLANNED
  imageUrl         String
  sectorId         String
  sector           Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  activities       Activity[]
  products         Product[]
  documentations   Documentation[]
}

model Activity {
  id               String   @id @default(uuid())
  title            String
  description      String
  location         String?
  date             DateTime?
  status           String   @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED
  
  programId        String?
  program          Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  sectorId         String
  sector           Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  documentations   Documentation[]
}

model Product {
  id               String   @id @default(uuid())
  name             String
  description      String
  category         String   @default("Umum")
  status           String   @default("AVAILABLE") // AVAILABLE, OUT_OF_STOCK
  imageUrl         String   @default("/images/placeholder.jpg")
  
  programId        String?
  program          Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  sectorId         String
  sector           Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
}

model Documentation {
  id               String   @id @default(uuid())
  title            String
  description      String?
  imageUrl         String
  date             DateTime?
  status           String   @default("PUBLISHED") // PUBLISHED, DRAFT
  
  programId        String?
  program          Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  
  activityId       String?
  activity         Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  sectorId         String
  sector           Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Metric {
  id               String   @id @default(uuid())
  name             String
  value            String
  unit             String?
  description      String?
  period           String
  status           String   @default("PUBLISHED") // PUBLISHED, DRAFT
  
  sectorId         String
  sector           Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
