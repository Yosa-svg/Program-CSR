generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password       String
  role           String    // SUPER_ADMIN, ADMIN_PUSAT, ADMIN_SEKTOR
  
  sectorId       String?   // Hanya untuk ADMIN_SEKTOR
  sector         Sector?   @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Sector {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String          @unique
  users          User[]
  programs       Program[]
  activities     Activity[]
  products       Product[]
  documentations Documentation[]
  metrics        Metric[]
}

model Program {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  description      String
  location         String
  beneficiaries    String
  status           String   @default("ACTIVE") // ACTIVE, COMPLETED, PLANNED
  imageUrl         String
  isPublished      Boolean  @default(false)
  
  // Phase 15.5 Integrity & Source
  source             String?
  sourceType         String?  // RESMI_ANTAM, PEMERINTAH, JURNAL_AKADEMIK, MEDIA_MASSA, DOKUMEN_LAPORAN
  sourceUrl          String?
  verificationStatus String?  @default("BELUM_TERVERIFIKASI") // BELUM_TERVERIFIKASI, MENUNGGU_VERIFIKASI, TERVERIFIKASI

  sectorId         String
  sector           Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  activities       Activity[]
  products         Product[]
  documentations   Documentation[]
  metrics          Metric[]
}

model Activity {
  id               String   @id @default(uuid())
  title            String
  description      String
  location         String?
  date             DateTime?
  status           String   @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED
  isPublished      Boolean  @default(false)
  
  // Phase 15.5 Integrity & Source
  source             String?
  sourceType         String?
  sourceUrl          String?
  verificationStatus String?  @default("BELUM_TERVERIFIKASI")

  programId        String?
  program          Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  sectorId         String
  sector           Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  documentations   Documentation[]
}

model Product {
  id               String   @id @default(uuid())
  name             String
  description      String
  category         String   @default("Umum")
  status           String   @default("AVAILABLE") // AVAILABLE, OUT_OF_STOCK
  imageUrl         String   @default("/images/placeholder.jpg")
  isPublished      Boolean  @default(false)
  
  // Phase 15.2 Details
  slug             String   @unique
  capacity         String?
  unit             String?
  marketing        String?
  certification    String?
  
  // Phase 15.5 Integrity & Source
  source             String?
  sourceType         String?
  sourceUrl          String?
  verificationStatus String?  @default("BELUM_TERVERIFIKASI")

  programId        String?
  program          Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  sectorId         String
  sector           Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  
  documentations   Documentation[]
}

model Documentation {
  id               String   @id @default(uuid())
  title            String
  description      String?
  imageUrl         String
  date             DateTime?
  status           String   @default("PUBLISHED") // PUBLISHED, DRAFT
  isPublished      Boolean  @default(false)
  
  // Phase 15.5 Integrity & Source
  source             String?
  sourceType         String?
  sourceUrl          String?
  verificationStatus String?  @default("BELUM_TERVERIFIKASI")
  
  programId        String?
  program          Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  
  activityId       String?
  activity         Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  sectorId         String
  sector           Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Metric {
  id                 String    @id @default(uuid())
  name               String
  description        String?
  category           String    @default("OUTCOME") // OUTPUT, OUTCOME, IMPACT, INDIKATOR
  unit               String?
  target             Float?
  realization        Float?
  value              String?
  year               Int?
  period             String?
  status             String    @default("PUBLISHED")
  isPublished        Boolean   @default(false)
  
  // Phase 15.5 Integrity & Source
  source             String?
  sourceType         String?
  sourceUrl          String?
  verificationStatus String?   @default("BELUM_TERVERIFIKASI")

  programId          String?
  program            Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)

  sectorId           String
  sector             Sector    @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
