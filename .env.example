# ==============================================================================
# CSR ANTAM - Environment Variables Template
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS OR PASSWORDS TO THIS REPOSITORY.
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# --- SERVER-ONLY CONFIGURATION (Never expose to browser) ---

# 1. Database Connection String (MySQL / TiDB)
# Supported schemes: mysql://, postgresql://, sqlite:
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# 2. Authentication Secret (HMAC-SHA256)
# Minimum length: 32 characters (256 bits) for cryptographic security
JWT_SECRET="replace-with-a-random-secret-key-at-least-32-characters-long"

# 3. Media Storage (Optional for Vercel Blob in production)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- RUNTIME ENVIRONMENT ---

# Environment Mode: "development" | "production" | "test"
NODE_ENV="development"

# --- PUBLIC CONFIGURATION (Exposed to client browser) ---

# Canonical Site URL (Used for metadata, sitemap.xml, and OpenGraph)
# Example dev: http://localhost:3000
# Example prod: https://csr-ubpnmalut.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
